# Environment variables for Cloud Run deployment via --env-vars-file=env.yaml
DATABASE_USER: "your_database_user"
DATABASE_PASS: "your_database_password"
DATABASE_IP: "your_database_host_or_ip"
DB_PORT: "3306"
SELECTED_DB: "your_database_name"
VERSION: "0.1.0"
ALLOWED_ORIGINS: "*"
SVS_STORAGE_PATH: "/mnt/slides"
